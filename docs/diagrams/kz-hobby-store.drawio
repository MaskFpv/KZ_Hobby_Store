<mxCell id="Act-1" value="&lt;b style='font-size:20px'&gt;Activity 1 - Belanja Ready Stock Online&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#666'&gt;Tamu/member membeli produk ready stock lewat website, bayar online (prototype), ambil di toko.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell>
