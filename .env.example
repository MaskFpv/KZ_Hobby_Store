APP_NAME="KZ Hobby Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# Identitas toko (nota, PDF, sidebar)
STORE_NAME="KZ Hobby Store"
STORE_TAGLINE="Anime Figure, Gunpla & Merchandise"
STORE_ADDRESS="Jakarta, Indonesia"
STORE_PHONE=-

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
